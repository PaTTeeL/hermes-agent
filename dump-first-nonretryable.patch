     except Exception:
         return None
+
+
+_FALLBACK_ABSORBED_DUMP_KEYS: set[tuple] = set()
+
+
+def _dump_request_for_fallback_absorbed_error(agent, api_kwargs, api_error, classified) -> None:
+    """Capture the wire request of an error a fallback is about to absorb.
+
+    dump_api_request_debug fires only on the terminal path (fallback chain exhausted), so a
+    provider error that a fallback papers over leaves no wire evidence for diagnosis. One
+    dump per (session, provider, model, classified reason) per process keeps a repeat storm
+    cheap.
+    """
+    reason_value = str(getattr(classified.reason, "value", getattr(classified, "reason", "")))
+    key = (getattr(agent, "session_id", ""), getattr(agent, "provider", ""),
+           getattr(agent, "model", ""), reason_value)
+    if key in _FALLBACK_ABSORBED_DUMP_KEYS:
+        return
+    if len(_FALLBACK_ABSORBED_DUMP_KEYS) > 256:
+        _FALLBACK_ABSORBED_DUMP_KEYS.clear()
+    _FALLBACK_ABSORBED_DUMP_KEYS.add(key)
+    try:
+        dump_path = agent._dump_api_request_debug(
+            api_kwargs, reason=f"fallback_absorbed:{reason_value}", error=api_error)
+        if dump_path:
+            _ra().logger.info("%sDumped fallback-absorbed request to %s", agent.log_prefix, dump_path)
+    except Exception:
+        _ra().logger.debug("Fallback-absorbed request dump failed", exc_info=True)
 
 
